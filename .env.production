# ==============================
# Puerto de la aplicación
# ==============================
APP_PORT=5000

# ==============================
# Base de datos (producción)
# ==============================
DB_HOST=prod-db-host
DB_PORT=5432
DB_USER=produser
DB_PASS=prodpass
DB_NAME=proddb

# ==============================
# Firebase
# ==============================
FIREBASE_SERVICE_ACCOUNT=src/config/llamaloio-firebase-adminsdk-prod.json
FIREBASE_STORAGE_BUCKET=llamaloio-prod.firebasestorage.app
FIREBASE_API_KEY=AIzaSyProdAPIKeyExample

# ==============================
# APIs externas
# ==============================
ELEVENLABS_API_KEY=sk_prod_elevenlabs_key
OPENAI_API_KEY=sk_prod_openai_key
DEEPGRAM_API_KEY=prod_deepgram_key
TWILIO_WEBHOOK_URL=https://llamaloiabackend.com/voice/incoming

# ==============================
# Logs
# ==============================
LOG_LEVEL=warn
