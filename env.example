STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs

# Firebase
FIREBASE_API_KEY=
# Bucket por proyecto (consola Firebase → Storage): formato habitual {projectId}.firebasestorage.app
#   Dev (llamaloio):           llamaloio.firebasestorage.app
#   Preprod (llamalo-preprod): llamalo-preprod.firebasestorage.app
#   Prod (llamalo-prod):       llamalo-prod.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Planes / suscripciones
# Trial cuenta gratis: 7 días (trialEndsAt en users). Límites técnicos = Starter mientras trial activo.
# En NODE_ENV=production, POST /users/plan responde 403 salvo:
# ALLOW_PLAN_CHANGE_MOCK=true
ALLOW_PLAN_CHANGE_MOCK=
# Colección Firestore `plans`: npm run seed:plans
# Usuarios sin trialEndsAt: npm run migrate:trial-ends

# Stripe (checkout + webhook en /stripe/webhook; rawBody en main.ts)
# Opcional: precio recurrente 0 € en Stripe (Product «Onboarding gratis») para que usuarios
# del flujo «7 días sin tarjeta» tengan también un objeto Subscription además del Customer.
STRIPE_PRICE_ONBOARDING_FREE=

STRIPE_SECRET_KEY=
# Webhook: invoice.paid|invoice.payment_succeeded (recibo), invoice.payment_failed (aviso cobro), checkout.session.completed, customer.subscription.*, subscription_schedule.*
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Mismo producto/plan que los mensuales, intervalo anual (Checkout con billingInterval: year)
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
# Minutos extra (precios metered en Stripe; mismo par mensual/anual que el plan base en checkout)
STRIPE_PRICE_STARTER_METERED=
STRIPE_PRICE_GROWTH_METERED=
STRIPE_PRICE_SCALE_METERED=
STRIPE_PRICE_STARTER_METERED_ANNUAL=
STRIPE_PRICE_GROWTH_METERED_ANNUAL=
STRIPE_PRICE_SCALE_METERED_ANNUAL=
# Billing Meters: event_name del medidor (Dashboard → mismo nombre que en el precio metered). Sin valor, no se reporta uso.
# Ejemplo: minutos_extra_starter, minutos_extra_growth, minutos_extra_scale
STRIPE_METER_EVENT_NAME_STARTER=
STRIPE_METER_EVENT_NAME_GROWTH=
STRIPE_METER_EVENT_NAME_SCALE=

# Anti-abuso: misma cuenta Twilio (Account SID) no puede repetir prueba Starter 7d entre usuarios distintos.
# En local/dev: dejar sin definir o false. En preprod (preprod.llamalo.ai) y producción (app.llamalo.ai): true.
ENFORCE_TWILIO_STARTER_TRIAL_REGISTRY=

# Deepgram Voice Agent (STT/LLM)
DG_VOICE_AGENT_API_KEY=
DG_VOICE_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DG_VOICE_AGENT_LANGUAGE=es
DG_LISTEN_PROVIDER=deepgram
DG_LISTEN_MODEL=nova-3
DG_SPEAK_PROVIDER=deepgram
DG_SPEAK_MODEL=aura-2-nestor-es
DG_THINK_PROVIDER=deepgram
DG_THINK_MODEL=dg-llama-3.1-8b
DG_THINK_TEMPERATURE=0.7
DG_KEEPALIVE_MS=15000
DG_MAX_BUFFERED_CHUNKS=25
DG_AGENT_PROMPT=

# ElevenLabs (solo TTS)
# Configuración optimizada para agentes de RRHH: profesional, empático y claro
# Ajustes para evitar voz robótica y entonaciones exageradas
ELEVENLABS_API_KEY=
ELEVENLABS_LANGUAGE=es
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_TTS_STABILITY=0.65
ELEVENLABS_TTS_STYLE=0.35
ELEVENLABS_TTS_SIMILARITY=0.75
ELEVENLABS_TTS_SPEAKER_BOOST=true
ELEVENLABS_TTS_VOICE_SPEED=1.0
ELEVENLABS_TTS_OUTPUT_FORMAT=ulaw_8000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=200
# Solo primer turno del usuario en llamadas Twilio (menor latencia); vacío desactiva el atajo
OPENAI_MODEL_FIRST_TURN=gpt-4o-mini
OPENAI_MAX_TOKENS_FIRST_TURN=250

# OpenAI Embeddings for Knowledge Base
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Vector Database
VECTOR_DB_TYPE=memory
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PATH=./data/chroma

# Web Scraping
PUPPETEER_HEADLESS=true
WEB_SCRAPING_TIMEOUT=30000

# Silence settings
SILENCE_PROMPT_TIMEOUT_MS=15000
SILENCE_HANGUP_TIMEOUT_MS=30000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# URL pública del API (sin barra final): OAuth/callbacks Shopify; al guardar credenciales Twilio se aplican POST /voice/incoming y /metrics/twilio-webhook por entorno (dev/preprod/prod).
APP_URL=http://localhost:3000
# SHOPIFY_SCOPES=read_products,read_orders,read_fulfillments,read_shipping
# ⚠️ ADVERTENCIA: Para incluir read_customers, descomentar y agregar:
# SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_fulfillments,read_shipping
# Nota: read_customers requiere justificación legal GDPR en la UE

# Email Service (SMTP para team@llamalo.ai)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=team@llamalo.ai
SMTP_PASS=yancdyzootjzpcxu
FRONTEND_URL=https://app.llamalo.ai

# Registro: código por correo; la ficha en Firestore `users` solo se crea tras verificar.
# Nuevo dispositivo: tras el primer login verificado, otros navegadores piden código al correo.
REQUIRE_EMAIL_VERIFICATION_PIN=true
REQUIRE_NEW_DEVICE_VERIFICATION=true

# Resend (envío transaccional). Dominio remitente verificado en https://resend.com/domains
RESEND_API_KEY=
# Opcional: remitente (por defecto SMTP_USER / team@llamalo.ai)
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# MailerLite (sincronización automática de grupos de usuarios)
# Obtener API Key en: https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=

