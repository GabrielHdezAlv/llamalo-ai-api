# ==============================
# Puerto de la aplicación
# ==============================
APP_PORT=4000

# ==============================
# Base de datos (preproducción)
# ==============================
DB_HOST=preprod-db-host
DB_PORT=5432
DB_USER=preproduser
DB_PASS=preprodpass
DB_NAME=preproddb

# ==============================
# Firebase
# ==============================
FIREBASE_SERVICE_ACCOUNT=src/config/llamaloio-firebase-adminsdk-preprod.json
FIREBASE_STORAGE_BUCKET=llamaloio-preprod.firebasestorage.app
FIREBASE_API_KEY=AIzaSyPreprodAPIKeyExample

# ==============================
# APIs externas
# ==============================
ELEVENLABS_API_KEY=sk_preprod_elevenlabs_key
OPENAI_API_KEY=sk_preprod_openai_key
DEEPGRAM_API_KEY=preprod_deepgram_key
TWILIO_WEBHOOK_URL=https://preprod.llamaloiabackend.com/voice/incoming

# ==============================
# Logs
# ==============================
LOG_LEVEL=info
